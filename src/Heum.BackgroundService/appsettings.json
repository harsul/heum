{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "OutboxProcessor": {
    "PollingInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 5,
    "RetentionPeriod": "7.00:00:00"
  }
}
