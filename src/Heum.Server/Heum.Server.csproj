<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1903;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Heum.Server.xUnit" />
    <InternalsVisibleTo Include="Heum.Server.xIntegration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heum.Contracts\Heum.Contracts.csproj" />
    <ProjectReference Include="..\Heum.Data\Heum.Data.csproj" />
    <ProjectReference Include="..\Heum.Infrastructure\Heum.Infrastructure.csproj" />
    <ProjectReference Include="..\Heum.ServiceDefaults\Heum.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Messaging.ServiceBus" Version="13.5.3" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.5.3" />
    <PackageReference Include="Aspire.Keycloak.Authentication" Version="13.5.3-preview.1.26425.3" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.5.3" />
    <PackageReference Include="Aspire.StackExchange.Redis.OutputCaching" Version="13.5.3" />
    <PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
  </ItemGroup>
</Project>
