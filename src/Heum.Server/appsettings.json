{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeycloakAdmin": {
    "Realm": "saas-app",
    "ClientId": "dotnet-admin-api"
  },
  "RateLimiting": {
    "Tenant": {
      "RequestsPerWindow": 600,
      "WindowSeconds": 60
    }
  }
}
