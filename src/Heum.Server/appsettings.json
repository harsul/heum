{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeycloakAdmin": {
    "Realm": "saas-app",
    "ClientId": "dotnet-admin-api"
  },
  "RateLimiting": {
    "Tenant": {
      "RequestsPerWindow": 600,
      "WindowSeconds": 60
    },
    "Global": {
      "AnonymousPermitLimit": 60,
      "AnonymousWindowSeconds": 60,
      "AuthenticatedPermitLimit": 120,
      "AuthenticatedWindowSeconds": 60,
      "RegistrationPermitLimit": 5,
      "RegistrationWindowSeconds": 900
    }
  }
}
