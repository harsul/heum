{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeycloakAdmin": {
    "Realm": "saas-app",
    "ClientId": "dotnet-admin-api"
  },
  "RateLimiting": {
    "Fixed": { "PermitLimit": 60, "Window": "00:01:00", "QueueLimit": 0 },
    "Registration": { "PermitLimit": 5, "Window": "00:15:00", "QueueLimit": 0 },
    "Authenticated": { "PermitLimit": 120, "Window": "00:01:00", "QueueLimit": 0 },
    "GlobalAuthenticated": { "PermitLimit": 120, "Window": "00:01:00" },
    "GlobalAnonymous": { "PermitLimit": 60, "Window": "00:01:00" }
  }
}
